# ===== Database =====
# Get this from MongoDB Atlas (free tier is fine): https://www.mongodb.com/cloud/atlas/register
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/iccha
MONGO_URI=

# ===== Auth =====
# Any long random string — used to sign login tokens. Generate one at
# https://generate-secret.vercel.app/32 or just mash your keyboard for 40+ characters.
JWT_SECRET=

# A password only YOU know. Required in the request header (x-admin-key) to
# add, edit, or delete products. Put this same value into admin.js (see README).
ADMIN_KEY=

# ===== Image uploads (Cloudinary — free tier) =====
# Sign up at https://cloudinary.com/users/register/free, then find these three
# values on your Cloudinary dashboard homepage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Server =====
PORT=5000

# Your live site URL once you have it — used to build password reset links.
FRONTEND_URL=https://theiccha.com

# Comma-separated list of allowed origins. Since this server also serves your
# frontend directly, you can usually leave this as * (default).
CORS_ORIGIN=*

# ===== Payments (Razorpay — supports UPI, Cards, Netbanking, Wallets) =====
# Sign up at https://dashboard.razorpay.com/signup, then find these under
# Settings → API Keys. Start in Test Mode until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== Email (optional — only needed for password reset emails) =====
# Leave these blank while testing; reset links will just print to the server logs instead.
# Example using Gmail: host=smtp.gmail.com, port=587, and an "app password" (not your real password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ICCHA <no-reply@theiccha.com>"
